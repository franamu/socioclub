      "name": "Actividades",
      "item": [
        {
          "name": "Listar actividades",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Son 8 y todas traen cupoDisponible', function () {",
                  "    const lista = pm.response.json();",
                  "    pm.expect(lista).to.have.lengthOf(8);",
                  "    lista.forEach(function (a) { pm.expect(a.cupoDisponible).to.be.a('number'); });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actividades",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actividades"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Filtrar por disciplina Ajedrez",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Solo devuelve Ajedrez', function () {",
                  "    const lista = pm.response.json();",
                  "    pm.expect(lista).to.have.lengthOf(1);",
                  "    pm.expect(lista[0].disciplina).to.eql('Ajedrez');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
